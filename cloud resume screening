import pandas as pd
from datetime import datetime
from google.colab import files

# ==========================================
# CLOUD-BASED RESUME SCREENING SYSTEM
# ==========================================

results = []

while True:

    print("\n======================================")
    print(" CLOUD-BASED RESUME SCREENING SYSTEM")
    print("======================================")
    print("1. Screen Resume")
    print("2. View Results")
    print("3. Save Results")
    print("4. Exit")

    choice = input("\nEnter your choice: ")

    # --------------------------------------
    # 1. SCREEN RESUME
    # --------------------------------------
    if choice == "1":

        name = input("\nEnter Candidate Name: ")

        resume = input("Enter Resume Skills: ").lower()

        required = input(
            "Enter Required Skills (comma separated): "
        ).lower()

        required_skills = [
            skill.strip()
            for skill in required.split(",")
        ]

        matched_skills = []

        for skill in required_skills:
            if skill in resume:
                matched_skills.append(skill)

        # Calculate percentage
        if len(required_skills) > 0:
            percentage = (
                len(matched_skills)
                / len(required_skills)
            ) * 100
        else:
            percentage = 0

        # Decision
        if percentage >= 60:
            status = "SHORTLISTED"
        else:
            status = "REJECTED"

        # Display result
        print("\n----------- SCREENING RESULT -----------")
        print("Candidate Name :", name)
        print("Matched Skills :", ", ".join(matched_skills))
        print("Match Percentage:", round(percentage, 2), "%")
        print("Status          :", status)

        # Store result
        results.append({
            "Candidate Name": name,
            "Matched Skills": ", ".join(matched_skills),
            "Match Percentage": round(percentage, 2),
            "Status": status,
            "Date": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        })

    # --------------------------------------
    # 2. VIEW RESULTS
    # --------------------------------------
    elif choice == "2":

        if len(results) == 0:
            print("\nNo results available.")

        else:
            df = pd.DataFrame(results)

            print("\n=========== ALL RESULTS ===========")
            display(df)

    # --------------------------------------
    # 3. SAVE RESULTS
    # --------------------------------------
    elif choice == "3":

        if len(results) == 0:
            print("\nNo results available to save.")

        else:
            df = pd.DataFrame(results)

            file_name = "resume_screening_results.csv"

            df.to_csv(file_name, index=False)

            print("\nResults saved successfully!")
            print("File Name:", file_name)

            files.download(file_name)

    # --------------------------------------
    # 4. EXIT
    # --------------------------------------
    elif choice == "4":

        print("\nThank you for using")
        print("Cloud-Based Resume Screening System!")
        break

    else:
        print("\nInvalid choice. Please enter 1, 2, 3 or 4.")